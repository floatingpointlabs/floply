#!/usr/bin/env bash

# shell.nix provisions Python + Poetry, installs deps, and activates .venv
use nix

# Check dependencies
command -v pyenv >/dev/null || { echo "pyenv required"; exit 1; }
pyenv versions --bare | grep -q "3.12.6" || { echo "Python 3.12.6 not installed"; exit 1; }

# Setup Python and virtual environment
pyenv local 3.12.6
export PATH="$(pyenv root)/versions/3.12.6/bin:$PATH"

[[ ! -d ".venv" ]] && $(pyenv which python) -m venv .venv
source .venv/bin/activate

# Setup poetry and dependencies
command -v poetry >/dev/null || pip install poetry >/dev/null
[[ -f "pyproject.toml" ]] && poetry install

# Load environment variables
dotenv_if_exists .env
