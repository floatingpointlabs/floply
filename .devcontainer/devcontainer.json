{
  "name": "Floply",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "app/routes/+page.svelte"]
    },
    "vscode": {
      "extensions": ["svelte.svelte-vscode", "bradlc.vscode-tailwindcss"]
    }
  },
  "updateContentCommand": "corepack enable && pnpm install",
  "postAttachCommand": {
    "server": "pnpm dev --host 0.0.0.0"
  },
  "portsAttributes": {
    "5173": {
      "label": "Floply",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [5173]
}
